{
  "name": "kala",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently --kill-others -n WEB,ROOMS -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace @kala/frontend",
    "dev:backend": "node backend/src/server.js --dev",
    "build": "npm run build --workspace @kala/frontend",
    "start": "node backend/src/server.js"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
